root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,hpp}]
indent_style = tab

[{SConstruct,SCsub,*.py}]
indent_style = space
indent_size = 4

[*.{gd,tscn,tres,godot,gdextension,cfg}]
indent_style = tab

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
