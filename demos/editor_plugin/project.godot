; Engine configuration file.

config_version=5

[application]

config/name="Editor Plugin with Julia"
config/description="A Julia @tool EditorPlugin that adds a dock and a custom node type, and a @tool node
that runs and draws in the editor."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[editor_plugins]

enabled=PackedStringArray("res://addons/julia_spinner/plugin.cfg")
