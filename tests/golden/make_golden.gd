# Evaluates each GDScript expression from the cases file and writes "<expression>\t<var_to_str(result)>" lines.
# Run via scripts/make_math_golden.jl.
extends SceneTree


func _init() -> void:
	var args := OS.get_cmdline_user_args()
	var input := FileAccess.open(args[0], FileAccess.READ)
	var output := FileAccess.open(args[1], FileAccess.WRITE)
	output.store_line("# GENERATED by scripts/make_math_golden.jl with Godot " + Engine.get_version_info().string)
	while not input.eof_reached():
		var line := input.get_line().strip_edges()
		if line.is_empty() or line.begins_with("#"):
			continue
		var script := GDScript.new()
		script.source_code = "static func f():\n\treturn " + line + "\n"
		if script.reload() != OK:
			output.store_line(line + "\t!COMPILE_ERROR")
			continue
		output.store_line(line + "\t" + var_to_str(script.call("f")))
	output.close()
	quit()
